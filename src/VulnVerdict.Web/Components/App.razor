<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["fonts.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["VulnVerdict.Web.styles.css"]" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="apple-touch-icon" href="@Assets["apple-touch-icon.png"]" />
    @* Installable as an app from the browser menu. There is deliberately no service worker: Blazor Server needs its live
       connection to the console, so an offline shell would only show a page that cannot work. *@
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#1E222A" data-scheme="light" data-light="#1E222A" data-dark="#0F1114" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0F1114" data-scheme="dark" data-light="#1E222A" data-dark="#0F1114" />
    <script src="@Assets["console.js"]"></script>
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>

<body>
    <Routes @rendermode="RenderModeForPage" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? RenderModeForPage => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
