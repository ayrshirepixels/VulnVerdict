@inherits LayoutComponentBase

<div class="shell">
    @* Phone only: the top bar and its menu button. console.js opens and closes the drawer; see app.css. *@
    <header class="topbar">
        <button type="button" class="nav-toggle" data-nav-toggle aria-label="Menu" aria-controls="sidebar" aria-expanded="false">
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
        <a class="brand" href="/"><img src="logo.svg" alt="" /><span class="word"><em>VULN</em>VERDICT</span></a>
    </header>
    <div class="nav-backdrop" data-nav-close></div>
    <aside class="sidebar" id="sidebar">
        <a class="brand" href="/"><img src="logo.svg" alt="" /><span class="word"><em>VULN</em>VERDICT</span></a>
        <div class="tagline">Cut the noise. Know your risk.</div>
        <nav>
            <NavLink href="/" Match="NavLinkMatch.All">Today</NavLink>
            <NavLink href="/verdicts">Verdicts</NavLink>
            <NavLink href="/assets">Assets</NavLink>
            <NavLink href="/watchlist">Watchlist</NavLink>
            <NavLink href="/mapping">Needs mapping</NavLink>
            <NavLink href="/connectors">Connectors</NavLink>
            <NavLink href="/suppressions">Suppressions</NavLink>
            <NavLink href="/digests">Digests</NavLink>
            <NavLink href="/reports">Reports</NavLink>
            <NavLink href="/sources">Sources</NavLink>
            <AuthorizeView Roles="Administrator">
                <NavLink href="/settings">Settings</NavLink>
                <NavLink href="/licence">Licence and updates</NavLink>
                <NavLink href="/users">Users</NavLink>
                <NavLink href="/audit">Audit log</NavLink>
            </AuthorizeView>
        </nav>
        <div class="sidebar-foot">
            <div class="theme-toggle" role="group" aria-label="Colour theme">
                <button type="button" data-theme-set="auto" title="Follow this device">Auto</button>
                <button type="button" data-theme-set="light">Light</button>
                <button type="button" data-theme-set="dark">Dark</button>
            </div>
            <AuthorizeView>
                <div class="who">@context.User.Identity?.Name<br /><small>@(context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</small></div>
                <form method="post" action="/auth/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-ghost btn-sm">Sign out</button>
                </form>
            </AuthorizeView>
        </div>
    </aside>
    <main class="content">
        <AuthorizeView><HealthBanner /></AuthorizeView>
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong in the console.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>
