@page "/setup"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>First run - VulnVerdict</PageTitle>

<div class="auth-wrap">
    <div class="auth-card">
        <div class="brand"><img src="logo.svg" alt="" /><span class="word"><em>VULN</em>VERDICT</span></div>
        <p class="muted" style="margin:0 0 18px">First run. Create the local administrator account.</p>
        @if (Error is not null)
        {
            <div class="alert alert-error">@Error</div>
        }
        <form method="post" action="/auth/setup" class="form">
            <AntiforgeryToken />
            <div>
                <label for="username">Username</label>
                <input id="username" name="username" type="text" required autofocus autocomplete="username" placeholder="for example admin" />
            </div>
            <div>
                <label for="email">Email (optional, used for administrator alerts)</label>
                <input id="email" name="email" type="email" />
            </div>
            <div>
                <label for="password">Password (at least 12 characters)</label>
                <input id="password" name="password" type="password" minlength="12" required autocomplete="new-password" />
            </div>
            <div class="btn-row">
                <button type="submit" class="btn">Create account and continue</button>
            </div>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (await Auth.HasUsersAsync()) Nav.NavigateTo("/login");
    }
}
