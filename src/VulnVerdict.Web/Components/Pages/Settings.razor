@page "/settings"
@attribute [Authorize(Roles = "Administrator")]
@inject SettingsService SettingsSvc
@inject EmailService Email
@inject LlmService Llm
@inject ConnectorService ConnectorSvc
@inject AuthService Auth
@inject NavigationManager Nav
@inject HealthNotices Notices

<PageTitle>Settings - VulnVerdict</PageTitle>

<div class="page">
    <h1>Settings</h1>
    <p class="lead">Opinionated defaults. The only things you must set are where the digest goes and how mail leaves the box.</p>

    @if (First is not null)
    {
        <div class="alert alert-info"><b>Welcome.</b> Feeds are already loading in the background. Set the mail server and digest recipients below, then add what you run under <a href="/watchlist">Watchlist</a>. Your first digest arrives at the next scheduled time.</div>
    }
    @if (_notice is not null) { <div class="alert alert-ok">@_notice</div> }
    @if (_error is not null) { <div class="alert alert-error">@_error</div> }

    @if (_s is null) { <p class="muted">Loading...</p> }
    else
    {
        <div class="card">
            <h2>Digest</h2>
            <div class="form">
                <div class="row-3">
                    <div><label>Send at (local time)</label><input type="text" @bind="_s.DigestTime" placeholder="07:30" /></div>
                    <div><label>Time zone (IANA)</label><input type="text" @bind="_s.TimeZone" placeholder="Europe/London" /></div>
                    <div><label>Organisation name (subject line)</label><input type="text" @bind="_s.OrganisationName" /></div>
                </div>
                <div><label>Recipients (comma separated)</label><input type="text" @bind="_s.DigestRecipients" placeholder="it@example.co.uk, msp-desk@example.com" /><div class="help">Reporters: people who get the email without a console login.</div></div>
                <label class="check"><input type="checkbox" @bind="_s.DigestWeekdaysOnly" /> Weekdays only</label>
                <div><label>Console address (used for links in emails)</label><input type="text" @bind="_s.BaseUrl" placeholder="https://vulnverdict.internal" /></div>
            </div>
        </div>

        <div class="card">
            <h2>Mail</h2>
            <div class="form">
                <div class="row">
                    <div><label>Send mail through</label>
                        <select @bind="_s.MailTransport">
                            <option value="smtp">SMTP server</option>
                            <option value="m365">Microsoft 365 (Microsoft Graph)</option>
                            <option value="sendgrid">SendGrid API</option>
                            <option value="brevo">Brevo API</option>
                        </select></div>
                    <div><label>From address</label><input type="email" @bind="_s.SmtpFrom" placeholder="vulnverdict@example.co.uk" /><div class="help">@(_s.MailTransport switch { "m365" => "A mailbox in your Microsoft 365 tenant that the app registration may send as. A shared mailbox works and needs no licence.", "sendgrid" or "brevo" => "Must be a verified sender on " + (_s.MailTransport == "sendgrid" ? "SendGrid." : "Brevo."), _ => "The address mail comes from; your SMTP server must allow it." })</div></div>
                </div>
                @if (_s.MailTransport == "m365")
                {
                    <div class="row">
                        <div><label>Tenant ID</label><input type="text" @bind="_s.M365TenantId" placeholder="00000000-0000-0000-0000-000000000000" /><div class="help">Directory (tenant) ID from the app registration's overview page.</div></div>
                        <div><label>Application (client) ID</label><input type="text" @bind="_s.M365ClientId" /></div>
                    </div>
                    <div><label>Client secret</label><input type="password" @bind="_s.M365ClientSecret" autocomplete="new-password" /><div class="help">Stored encrypted. The app registration needs permission to send as the from mailbox only; <a href="https://github.com/ayrshirepixels/VulnVerdict/blob/main/docs/mail.md#microsoft-365" target="_blank" rel="noopener noreferrer">how to set it up</a>. Outbound HTTPS to login.microsoftonline.com and graph.microsoft.com is required.</div></div>
                    <div><label>Client secret expires on (optional)</label><input type="date" value="@_s.M365SecretExpires" @onchange="e => _s.M365SecretExpires = e.Value?.ToString() ?? string.Empty" /><div class="help">The console warns 30 days before, on screen and in the digest. The setup script prints this date.</div></div>
                }
                else if (_s.MailTransport == "smtp")
                {
                    <div class="row-3">
                        <div><label>SMTP host</label><input type="text" @bind="_s.SmtpHost" placeholder="smtp.example.co.uk" /><div class="help">On Microsoft 365, choose Microsoft 365 above instead: Exchange Online is retiring password sign-in for SMTP.</div></div>
                        <div><label>Port</label><input type="number" @bind="_s.SmtpPort" /></div>
                        <div><label>Security</label><select @bind="_s.SmtpSecurity"><option value="auto">Auto</option><option value="starttls">STARTTLS</option><option value="ssl">SSL on connect</option><option value="none">None</option></select></div>
                    </div>
                    <div class="row">
                        <div><label>Username</label><input type="text" @bind="_s.SmtpUsername" /></div>
                        <div><label>Password</label><input type="password" @bind="_s.SmtpPassword" autocomplete="new-password" /><div class="help">Stored encrypted.</div></div>
                    </div>
                }
                else
                {
                    <div><label>@(_s.MailTransport == "sendgrid" ? "SendGrid API key (Mail Send permission)" : "Brevo API key (v3, transactional email)")</label><input type="password" @bind="_s.MailApiKey" autocomplete="new-password" /><div class="help">Stored encrypted. Outbound HTTPS to @(_s.MailTransport == "sendgrid" ? "api.sendgrid.com" : "api.brevo.com") is required.</div></div>
                }
                <div class="btn-row"><button class="btn btn-secondary" @onclick="TestMail" disabled="@_busy">Save and send a test email</button></div>
                @if (_mailFailure is not null) { <div class="alert alert-error" style="margin-top:10px">@_mailFailure.Text</div> }
                else if (_mailLastSent is not null) { <p class="muted" style="margin:8px 0 0">Mail last went out @_mailLastSent.</p> }
            </div>
        </div>

        <div class="card">
            <h2>Tickets and alerts</h2>
            <div class="form">
                <div class="row">
                    <div><label>Helpdesk intake address</label><input type="email" @bind="_s.HelpdeskIntakeAddress" placeholder="support@example.co.uk" /><div class="help">One email per Fix today and Fix this week verdict, with a correlation key in the subject. Leave blank to disable.</div></div>
                    <div><label>Administrator alert address</label><input type="email" @bind="_s.AdminAlertAddress" /><div class="help">Stale feeds, a stopped worker, a digest that could not be sent.</div></div>
                </div>
                <div class="row">
                    <div><label>Ticket channel</label>
                        <select @bind="_s.TicketChannel">
                            <option value="email">Email to the helpdesk intake address</option>
                            @foreach (var c in _ticketConnectors) { <option value="@c.Id">@c.DisplayName</option> }
                        </select>
                        <div class="help">Native helpdesk adapters are added under Connectors and appear here.</div></div>
                    <div style="align-self:end"><label class="check"><input type="checkbox" @bind="_s.TicketsEnabled" /> Raise tickets for Fix today and Fix this week</label></div>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>Weekly report and webhooks</h2>
            <div class="form">
                <div class="row">
                    <div><label>Weekly report recipients</label><input type="text" @bind="_s.ReportRecipients" placeholder="md@example.co.uk" /><div class="help">The management summary: new, affecting us, actioned, overdue, dismissed. Leave blank to skip the email; the report is always available under Reports.</div></div>
                    <div><label>Send on</label><select @bind="_s.ReportDay">@foreach (var d in Enum.GetNames<DayOfWeek>()) { <option value="@d">@d</option> }</select></div>
                </div>
                <div class="row">
                    <div><label>Webhook URL</label><input type="text" @bind="_s.WebhookUrl" placeholder="https://hooks.example.com/vulnverdict" /><div class="help">Receives verdict created, promoted and closed events as JSON, signed with HMAC-SHA256 (see docs/api.md).</div></div>
                    <div><label>Webhook secret</label><input type="password" @bind="_s.WebhookSecret" autocomplete="new-password" /></div>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>SLA (days)</h2>
            <div class="form"><div class="row-3">
                <div><label>Fix today</label><input type="number" @bind="_s.SlaFixTodayDays" /></div>
                <div><label>Fix this week</label><input type="number" @bind="_s.SlaFixThisWeekDays" /></div>
                <div><label>Next patch cycle</label><input type="number" @bind="_s.SlaNextPatchCycleDays" /></div>
            </div></div>
        </div>

        <div class="card">
            <h2>Single sign-on (OpenID Connect)</h2>
            <p class="muted" style="margin-top:0">Microsoft Entra, Google Workspace or any OIDC provider. Redirect URI: <code>@(_s.BaseUrl.TrimEnd('/'))/signin-oidc</code>. Roles come from a group claim; everyone else is a Viewer.</p>
            <div class="form">
                <label class="check"><input type="checkbox" @bind="_s.OidcEnabled" /> Enabled</label>
                <div class="row-3">
                    <div><label>Button label</label><input type="text" @bind="_s.OidcDisplayName" /></div>
                    <div><label>Authority</label><input type="text" @bind="_s.OidcAuthority" placeholder="https://login.microsoftonline.com/TENANT-ID/v2.0" /></div>
                    <div><label>Client id</label><input type="text" @bind="_s.OidcClientId" /></div>
                </div>
                <div class="row-3">
                    <div><label>Client secret</label><input type="password" @bind="_s.OidcClientSecret" autocomplete="new-password" /></div>
                    <div><label>Group claim name</label><input type="text" @bind="_s.OidcGroupClaim" placeholder="groups" /></div>
                    <div></div>
                </div>
                <div class="row">
                    <div><label>Administrator group (id or name)</label><input type="text" @bind="_s.OidcAdminGroup" /></div>
                    <div><label>Operator group (id or name)</label><input type="text" @bind="_s.OidcOperatorGroup" /></div>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>AI explanations</h2>
            <p class="muted" style="margin-top:0">Optional. The AI never decides a verdict; it explains one in plain English and describes how an attacker would have to go about it. Bring your own key and model. Only the product, version, exposure level and the public CVE text are sent; asset names and addresses never leave the box. Results are cached with the model and prompt version recorded.</p>
            <div class="form">
                <div class="row-3">
                    <div><label>Provider</label>
                        <select @bind="_s.LlmProvider">
                            <option value="none">Off</option>
                            <option value="anthropic">Anthropic (Claude)</option>
                            <option value="openai">OpenAI</option>
                            <option value="openai-compatible">OpenAI-compatible endpoint (Ollama, vLLM, LM Studio)</option>
                        </select></div>
                    <div><label>Model</label><input type="text" @bind="_s.LlmModel" placeholder="@(_s.LlmProvider == "anthropic" ? "claude-opus-5" : _s.LlmProvider == "openai" ? "the model name from your OpenAI account" : "llama3.1")" /></div>
                    <div><label>API key</label><input type="password" @bind="_s.LlmApiKey" autocomplete="new-password" /><div class="help">Stored encrypted. Optional for a local endpoint.</div></div>
                </div>
                @if (_s.LlmProvider == "openai-compatible")
                {
                    <div><label>Base URL</label><input type="text" @bind="_s.LlmBaseUrl" placeholder="http://ollama:11434/v1" /><div class="help">The endpoint must serve /chat/completions. For a fully offline site, run Ollama on the same VM.</div></div>
                }
                <div class="btn-row"><button class="btn btn-secondary" @onclick="TestLlm" disabled="@_busy">Save and test the AI connection</button></div>
            </div>
        </div>

        <div class="card">
            <h2>API</h2>
            <p class="muted" style="margin-top:0">Read verdicts, the watchlist and the digest, or import a watchlist, with <code>Authorization: Bearer TOKEN</code> against <code>/api/verdicts</code>, <code>/api/watchlist</code> and <code>/api/digest</code>.</p>
            <div class="form"><div class="row"><div><label>API token</label><input type="text" @bind="_s.ApiToken" /></div><div style="align-self:end"><button class="btn btn-secondary" @onclick="() => _s.ApiToken = Convert.ToHexString(System.Security.Cryptography.RandomNumberGenerator.GetBytes(24)).ToLowerInvariant()">Generate</button></div></div></div>
        </div>

        <div class="btn-row" style="margin-bottom:30px"><button class="btn" @onclick="Save" disabled="@_busy">Save settings</button></div>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "first")] public string? First { get; set; }
    private AppSettings? _s;
    private bool _busy;
    private string? _notice, _error;

    private List<Connector> _ticketConnectors = new();

    protected override async Task OnInitializedAsync()
    {
        _s = await SettingsSvc.LoadAsync();
        _ticketConnectors = (await ConnectorSvc.ListAsync()).Where(c => ConnectorSvc.IsTicketAdapter(c.AdapterId)).ToList();
        await LoadMailHealthAsync();
    }

    private HealthNotices.Notice? _mailFailure;
    private string? _mailLastSent;

    private async Task LoadMailHealthAsync()
    {
        _mailFailure = await Notices.MailFailureAsync();
        var last = await SettingsSvc.GetStateAsync(SettingsService.Keys.MailLastSuccess);
        _mailLastSent = DateTime.TryParse(last, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.RoundtripKind, out var d)
            ? Ui.Ago(d.ToUniversalTime()) : null;
    }

    private async Task Save()
    {
        if (_s is null) return;
        _busy = true; _error = null; _notice = null;
        try
        {
            await SettingsSvc.SaveAsync(_s, Ui.Actor((await AuthState).User));
            Auth.ReloadOidc();
            _notice = "Settings saved.";
        }
        catch (Exception ex) { _error = ex.Message; }
        _busy = false;
    }

    private async Task TestLlm()
    {
        await Save();
        if (_error is not null) return;
        _busy = true;
        try
        {
            var reply = await Llm.TestAsync();
            _notice = "Settings saved. The model replied: " + reply.Trim();
        }
        catch (Exception ex) { _error = "AI test failed: " + ex.Message; }
        _busy = false;
    }

    private async Task TestMail()
    {
        await Save();
        if (_error is not null) return;
        _busy = true;
        try
        {
            var to = _s!.Recipients.FirstOrDefault() ?? _s.AdminAlertAddress;
            if (string.IsNullOrWhiteSpace(to)) throw new InvalidOperationException("Add a digest recipient or an administrator alert address first.");
            await Email.SendAsync(new[] { to }, "VulnVerdict test email", "<p>Mail from VulnVerdict works.</p>", "Mail from VulnVerdict works.");
            _notice = "Settings saved and a test email was sent to " + to + ".";
        }
        catch (Exception ex) { _error = "Test email failed: " + ex.Message; }
        await LoadMailHealthAsync();
        _busy = false;
    }
}
