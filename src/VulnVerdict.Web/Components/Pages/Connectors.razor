@page "/connectors"
@using VulnVerdict.Core.Adapters
@using VulnVerdict.Core.Adapters.Linux
@implements IDisposable
@inject ConnectorService ConnectorSvc
@inject SettingsService Settings

<PageTitle>Connectors - VulnVerdict</PageTitle>

<div class="page">
    <h1>Connectors</h1>
    <p class="lead">Every source is an adapter, every adapter is one credential form: a hostname and a read-only account. Adapters never write to the source. Three failures in a row alert the administrator.</p>

    @if (_notice is not null) { <div class="alert alert-ok">@_notice</div> }
    @if (_error is not null) { <div class="alert alert-error">@_error</div> }

    <AuthorizeView Roles="Administrator">
        <div class="card">
            <h2>@(_editId is null ? "Add a connector" : "Edit connector")</h2>
            <div class="form">
                <div class="row">
                    <div><label>Source</label>
                        <select @bind="_metaId" @bind:after="AdapterChanged" disabled="@(_editId is not null)">
                            <option value="">choose...</option>
                            @foreach (var a in ConnectorSvc.Adapters.Select(x => x.Metadata)) { <option value="@a.Id">@a.DisplayName</option> }
                            @foreach (var a in ConnectorSvc.TicketAdapters.Select(x => x.Metadata)) { <option value="@a.Id">Tickets: @a.DisplayName</option> }
                        </select></div>
                    <div><label>Name (as shown in evidence)</label><input type="text" @bind="_name" placeholder="@(_meta?.DisplayName)" /></div>
                </div>
                @if (_meta is not null)
                {
                    <p class="muted" style="margin:0">@_meta.Description<br /><b>Minimum permission:</b> @_meta.MinimumPermission @if (_meta.DocsUrl is not null) { <a href="@_meta.DocsUrl" target="_blank" rel="noopener noreferrer">vendor instructions</a> }</p>
                    @foreach (var f in _meta.Form)
                    {
                        <div>
                            @if (f.Type == CredentialTypes.Bool)
                            {
                                <label class="check"><input type="checkbox" checked="@(_values.GetValueOrDefault(f.Key) == "true")" @onchange="e => SetBool(f.Key, e)" /> @f.Label</label>
                            }
                            else if (f.Type is CredentialTypes.TextArea or CredentialTypes.SecretArea)
                            {
                                <label>@f.Label@(f.Required ? "" : " (optional)")</label>
                                <textarea value="@_values.GetValueOrDefault(f.Key)" @oninput="e => SetText(f.Key, e)" rows="4" autocomplete="off" spellcheck="false" placeholder="@(f.Type == CredentialTypes.SecretArea && _editId is not null ? "unchanged (paste a new one to replace it)" : "")"></textarea>
                            }
                            else
                            {
                                <label>@f.Label@(f.Required ? "" : " (optional)")</label>
                                <input type="@InputType(f)" value="@_values.GetValueOrDefault(f.Key)" @oninput="e => SetText(f.Key, e)" autocomplete="off" placeholder="@(f.Type == CredentialTypes.Password && _editId is not null ? "unchanged" : "")" />
                            }
                            @if (f.Help is not null) { <div class="help">@f.Help</div> }
                        </div>
                    }
                    <div class="row"><div><label>Collect every (minutes)</label><input type="number" @bind="_interval" /></div><div style="align-self:end"><label class="check"><input type="checkbox" @bind="_enabled" /> Enabled</label></div></div>
                    <div class="btn-row">
                        <button class="btn btn-secondary" @onclick="TestAsync" disabled="@_busy">Test connection</button>
                        <button class="btn" @onclick="SaveAsync" disabled="@_busy">Save</button>
                        @if (_editId is not null) { <button class="btn btn-secondary" @onclick="Reset">Cancel</button><button class="btn btn-danger" @onclick="DeleteAsync">Delete</button> }
                    </div>
                    @if (_testResult is not null) { <div class="alert @(_testResult.Ok ? "alert-ok" : "alert-error")" style="margin-top:8px;white-space:pre-line">@_testResult.Message</div> }
                    @if (_hostKeys.Count > 0)
                    {
                        var fresh = _hostKeys.Count(k => k.Status == HostKeyStatus.New);
                        <div class="hostkeys">
                            <h3>SSH host keys@(_fromRun ? " from the last collection" : "")</h3>
                            <div class="help">A trusted key is pinned: the connector only signs in to that host while it presents that key. Before trusting one, compare the fingerprint with the server's own (on the server: <code>ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub</code>; on Windows the key files are in <code>C:\ProgramData\ssh</code>).</div>
                            @if (_hostKeyNotice is not null) { <div class="alert alert-ok">@_hostKeyNotice</div> }
                            <table class="table">
                                <thead><tr><th>Status</th><th>Host and the key it presented</th><th></th></tr></thead>
                                <tbody>
                                    @foreach (var k in _hostKeys)
                                    {
                                        <tr class="@(k.Status == HostKeyStatus.Changed ? "hostkey-changed" : "")">
                                            <td>
                                                @if (k.Status == HostKeyStatus.New) { <span class="state state-open">new host</span> }
                                                else if (k.Status == HostKeyStatus.Changed) { <b>key changed</b> }
                                                else { <span class="state state-closed">pinned</span> }
                                            </td>
                                            <td>@(k.Status == HostKeyStatus.New ? "New host: " : "")<b>@k.Host</b> presented <code>@k.KeyType @k.Display()</code></td>
                                            <td class="btn-row">
                                                @if (k.Status == HostKeyStatus.New) { <button class="btn btn-secondary btn-sm" @onclick="() => TrustAsync(k)" disabled="@_busy">Trust</button> }
                                                else if (k.Status == HostKeyStatus.Changed && !SameHostName(_replaceHost, k.Host)) { <button class="btn btn-danger btn-sm" @onclick="() => _replaceHost = k.Host" disabled="@_busy">Replace pinned key...</button> }
                                            </td>
                                        </tr>
                                        @if (k.Status == HostKeyStatus.Changed)
                                        {
                                            <tr class="hostkey-changed">
                                                <td colspan="3">
                                                    <div class="alert alert-error" role="alert">
                                                        <b>@k.Host is not presenting the key that was pinned.</b> Pinned: <code>@SshLinuxAdapter.FormatFingerprint(k.PinnedFingerprint ?? "")</code>. Presented now: <code>@k.KeyType @k.Display()</code>.<br />
                                                        Either the host was re-installed or its keys were regenerated, or something between the console and the host is intercepting the connection, and would be handed this connector's password. The connector will not sign in to it until this is settled. Have someone read the fingerprint on the server itself before replacing the key; it is never included in Trust all.
                                                        @if (SameHostName(_replaceHost, k.Host))
                                                        {
                                                            <div class="btn-row" style="margin-top:8px">
                                                                <span>Replace the pinned key for <b>@k.Host</b> with the one presented now?</span>
                                                                <button class="btn btn-danger btn-sm" @onclick="() => ReplaceAsync(k)" disabled="@_busy">Yes, the fingerprint is the server's: replace pinned key</button>
                                                                <button class="btn btn-secondary btn-sm" @onclick="() => _replaceHost = null">Cancel</button>
                                                            </div>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                            @if (fresh > 1) { <div class="btn-row" style="margin-top:8px"><button class="btn btn-secondary" @onclick="TrustAllNewAsync" disabled="@_busy">Trust all @fresh new hosts</button></div> }
                        </div>
                    }
                }
            </div>
        </div>
    </AuthorizeView>

    <table class="table">
        <thead><tr><th>Connector</th><th>Source</th><th>Every</th><th>Last success</th><th class="num">Assets</th><th class="num">Software</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in _list)
            {
                var stale = c.LastSuccess is null || DateTime.UtcNow - c.LastSuccess.Value > TimeSpan.FromMinutes(c.IntervalMinutes * 3);
                <tr style="@(c.Enabled ? "" : "opacity:.6")">
                    <td><b>@c.DisplayName</b>@(c.Enabled ? "" : " (disabled)")</td>
                    <td>@(ConnectorSvc.Metadata(c.AdapterId)?.DisplayName ?? c.AdapterId)</td>
                    <td>@c.IntervalMinutes min</td>
                    <td style="@(stale && c.Enabled ? "color:var(--amber-ink)" : "")">@Ui.Ago(c.LastSuccess)</td>
                    <td class="num">@c.AssetsLastRun</td><td class="num">@c.SoftwareLastRun</td>
                    <td>
                        @if (c.Running) { <span class="state state-open">running</span> <span class="progress">@c.Progress</span> }
                        else if (c.RunRequested) { <span class="state">queued</span> }
                        else if (c.ConsecutiveFailures > 0) { <span style="color:var(--amber-ink)">failed @c.ConsecutiveFailures time@(c.ConsecutiveFailures == 1 ? "" : "s"): @c.LastError</span> }
                        else if (c.LastSuccess is not null) { <span class="state state-closed">ok</span> <span class="progress">@c.Progress</span>@if (c.LastError is not null) { <div class="progress">@c.LastError</div> } }
                        else { <span class="muted">not run yet</span> }
                        @if (ConnectorService.PendingHostKeys(c) is { Count: > 0 } review)
                        {
                            var changed = review.Count(k => k.Status == HostKeyStatus.Changed);
                            <div class="hostkey-warning @(changed > 0 ? "hostkey-warning-changed" : "")">
                                @(changed > 0 ? changed + " SSH host key" + (changed == 1 ? " has" : "s have") + " changed" + (review.Count > changed ? ", " + (review.Count - changed) + " not pinned" : "") : review.Count + " SSH host" + (review.Count == 1 ? " is" : "s are") + " not pinned"); not collected until reviewed.
                                <AuthorizeView Roles="Administrator" Context="keys"><button class="btn btn-secondary btn-sm" @onclick="() => ReviewAsync(c)">Review host keys</button></AuthorizeView>
                            </div>
                        }
                    </td>
                    <td class="btn-row"><AuthorizeView Roles="Administrator,Operator" Context="auth">@if (!ConnectorSvc.IsTicketAdapter(c.AdapterId)) { <button class="btn btn-secondary btn-sm" @onclick="() => RunNow(c.Id)" disabled="@(c.Running || c.RunRequested)">Run now</button> }</AuthorizeView><AuthorizeView Roles="Administrator" Context="admin"><button class="btn btn-secondary btn-sm" @onclick="() => Edit(c)">Edit</button>@if (!ConnectorSvc.IsTicketAdapter(c.AdapterId)) { <form method="post" action="/connectors/@c.Id/diagnostics" data-enhance="false" style="display:inline"><AntiforgeryToken /><button type="submit" class="btn btn-secondary btn-sm" title="Runs the connector once without changing anything and downloads what its API returned, with names, users and addresses replaced. Look through it, then attach it to a GitHub issue.">Diagnostics</button></form> }</AuthorizeView>@if (!ConnectorSvc.IsTicketAdapter(c.AdapterId)) {<a class="btn btn-secondary btn-sm" href="@IssueLinks.ConnectorProblem(c.AdapterId, AppVersion.Current)" target="_blank" rel="noopener noreferrer" title="Opens a pre-filled GitHub issue in your browser">Report a problem</a> }</td>
                </tr>
            }
            @if (_list.Count == 0) { <tr><td colspan="8" class="muted">No connectors yet. The watchlist works without any; connectors add the estate.</td></tr> }
        </tbody>
    </table>

    <div class="card" style="margin-top:20px">
        <h2>Available sources</h2>
        <table class="table"><thead><tr><th>Source</th><th>What it sees</th><th>Needs</th></tr></thead>
            <tbody>@foreach (var a in ConnectorSvc.Adapters.Select(x => x.Metadata).Concat(ConnectorSvc.TicketAdapters.Select(x => x.Metadata))) { <tr><td><b>@a.DisplayName</b><br /><small class="muted">@a.Vendor</small></td><td>@a.Description</td><td>@a.MinimumPermission</td></tr> }</tbody></table>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private List<Connector> _list = new();
    private string _metaId = "", _name = "";
    private AdapterMetadata? _meta;
    private Dictionary<string, string> _values = new();
    private int _interval = 240;
    private bool _enabled = true, _busy;
    private Guid? _editId;
    private TestResult? _testResult;
    private string? _notice, _error;
    private System.Threading.Timer? _timer;
    /// <summary>?review=connector id: the link in the health banner, which opens that connector's host keys to review.</summary>
    [SupplyParameterFromQuery] public Guid? Review { get; set; }
    private Guid? _reviewed;
    // host keys from the last test, or from the last collection when reviewing; held here on the server, so what is trusted is what was presented
    private List<PresentedHostKey> _hostKeys = new();
    private bool _fromRun;
    private string? _replaceHost, _hostKeyNotice;

    protected override async Task OnInitializedAsync()
    {
        _list = await ConnectorSvc.ListAsync();
        _timer = new System.Threading.Timer(async _ => { try { _list = await ConnectorSvc.ListAsync(); await InvokeAsync(StateHasChanged); } catch { } }, null, 5000, 5000);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Review is null || Review == _reviewed) return;
        _reviewed = Review;
        if (_list.FirstOrDefault(c => c.Id == Review) is { } connector) await ReviewAsync(connector);
    }

    private async Task ReviewAsync(Connector c)
    {
        if (!await Ui.IsAdminAsync(AuthState)) return;
        await Edit(c);
        _hostKeys = ConnectorService.PendingHostKeys(c); _fromRun = true;
    }

    private void ClearHostKeys() { _hostKeys = new(); _fromRun = false; _replaceHost = null; _hostKeyNotice = null; }
    private static bool SameHostName(string? a, string b) => string.Equals(a, b, StringComparison.OrdinalIgnoreCase);

    private Task TrustAsync(PresentedHostKey key) => TrustAsync(new[] { key }, null);
    private Task TrustAllNewAsync() => TrustAsync(_hostKeys.Where(k => k.Status == HostKeyStatus.New).ToList(), null);
    // a changed key is only ever replaced one host at a time, after the confirmation
    private Task ReplaceAsync(PresentedHostKey key) => TrustAsync(new[] { key }, new HashSet<string>(StringComparer.OrdinalIgnoreCase) { key.Host });

    private async Task TrustAsync(IReadOnlyCollection<PresentedHostKey> keys, IReadOnlySet<string>? replace)
    {
        if (_meta is null || !await Ui.IsAdminAsync(AuthState)) return;
        _busy = true; _error = null; _hostKeyNotice = null; _replaceHost = null;
        try
        {
            // the form, so a later Save keeps the pins; and for a saved connector the stored credential straight away, audited
            var inForm = ConnectorService.ApplyTrust(_meta, _values, keys, replace);
            var saved = _editId is null ? new List<PresentedHostKey>() : await ConnectorSvc.TrustHostKeysAsync(_editId.Value, keys, replace, await ActorAsync());
            var done = inForm.Concat(saved).Select(k => k.Host).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _hostKeys = _hostKeys.Select(k => done.Contains(k.Host) ? k with { Status = HostKeyStatus.Pinned, PinnedFingerprint = k.Fingerprint } : k).ToList();
            var hosts = string.Join(", ", done.OrderBy(h => h, StringComparer.OrdinalIgnoreCase));
            if (done.Count == 0) _error = "Nothing was pinned: the form no longer names that host. Test the connection again.";
            else if (_editId is not null && saved.Count == done.Count)
            {
                await ConnectorSvc.RequestRunAsync(_editId.Value);
                _hostKeyNotice = "Pinned and saved: " + hosts + ". The saved password is kept; a collection starts within a minute.";
                _list = await ConnectorSvc.ListAsync();
            }
            else _hostKeyNotice = "Pinned in the form: " + hosts + ". Save the connector to keep " + (done.Count == 1 ? "it" : "them") + ".";
        }
        catch (Exception ex) { _error = ex.Message; }
        _busy = false;
    }

    private void AdapterChanged()
    {
        _meta = ConnectorSvc.Metadata(_metaId);
        _values = new();
        if (_meta is not null)
        {
            _interval = _meta.DefaultIntervalMinutes;
            foreach (var f in _meta.Form) if (f.Default is not null) _values[f.Key] = f.Default;
        }
        _testResult = null; ClearHostKeys();
    }

    // adding, editing, testing and deleting connectors is for administrators: a test sends the saved credential to the form's address
    private async Task Edit(Connector c)
    {
        if (!await Ui.IsAdminAsync(AuthState)) return;
        _editId = c.Id; _metaId = c.AdapterId; _meta = ConnectorSvc.Metadata(c.AdapterId); _name = c.DisplayName; _interval = c.IntervalMinutes; _enabled = c.Enabled;
        _values = ConnectorSvc.Decrypt(c);
        // saved secrets (passwords, private keys) are never sent back to the browser: blank means keep the saved one
        foreach (var f in _meta?.Form ?? Array.Empty<CredentialField>()) if (CredentialTypes.IsSecret(f.Type)) _values[f.Key] = "";
        _testResult = null; _notice = null; _error = null; ClearHostKeys();
    }

    private void SetText(string key, ChangeEventArgs e) => _values[key] = e.Value?.ToString() ?? string.Empty;
    private static string InputType(CredentialField f) => f.Type == CredentialTypes.Password ? "password" : f.Type == CredentialTypes.Number ? "number" : f.Type == CredentialTypes.Date ? "date" : "text";
    private void SetBool(string key, ChangeEventArgs e) => _values[key] = e.Value is bool b && b ? "true" : "false";

    private void Reset() { _editId = null; _metaId = ""; _meta = null; _name = ""; _values = new(); _testResult = null; _enabled = true; ClearHostKeys(); }

    private async Task<string> ActorAsync() => Ui.Actor((await AuthState).User);

    private async Task TestAsync()
    {
        if (!await Ui.IsAdminAsync(AuthState)) return;
        _busy = true; _testResult = null; ClearHostKeys();
        _testResult = await ConnectorSvc.TestAsync(_metaId, new Dictionary<string, string>(_values), _editId);
        _hostKeys = _testResult.HostKeys.ToList();
        _busy = false;
    }

    private async Task SaveAsync()
    {
        if (!await Ui.IsAdminAsync(AuthState)) return;
        _busy = true; _error = null; _notice = null;
        try
        {
            var c = await ConnectorSvc.SaveAsync(_editId, _metaId, _name, new Dictionary<string, string>(_values), _enabled, _interval, await ActorAsync());
            await ConnectorSvc.RequestRunAsync(c.Id);
            _notice = c.DisplayName + " saved; first collection starts within a minute.";
            Reset(); _list = await ConnectorSvc.ListAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        _busy = false;
    }

    private async Task DeleteAsync()
    {
        if (_editId is null || !await Ui.IsAdminAsync(AuthState)) return;
        await ConnectorSvc.DeleteAsync(_editId.Value, await ActorAsync());
        _notice = "Connector deleted. Its assets stay, marked unknown, until archived."; Reset(); _list = await ConnectorSvc.ListAsync();
    }

    private async Task RunNow(Guid id)
    {
        if (!await Ui.CanOperateAsync(AuthState)) return;
        await ConnectorSvc.RequestRunAsync(id); _list = await ConnectorSvc.ListAsync();
    }

    public void Dispose() => _timer?.Dispose();
}
