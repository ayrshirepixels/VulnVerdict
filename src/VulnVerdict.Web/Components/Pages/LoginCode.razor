@page "/login/code"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout EmptyLayout
@inject TwoFactorService TwoFactor
@inject NavigationManager Nav

<PageTitle>Two-factor - VulnVerdict</PageTitle>

<div class="auth-wrap">
    <div class="auth-card">
        <div class="brand"><img src="logo.svg" alt="" /><span class="word"><em>VULN</em>VERDICT</span></div>
        <p class="muted" style="margin:0 0 18px">The password is right. One more step.</p>

        @if (Error is not null)
        {
            <div class="alert alert-error">That code is not right, or it has been used already. Wait for the next one and try again.</div>
        }

        <form method="post" action="/auth/login/code" class="form">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <div>
                <label for="code">Code from your authenticator app</label>
                <input id="code" name="code" type="text" autocomplete="one-time-code" required autofocus />
                <div class="help">No phone to hand? Type one of your recovery codes instead. Each works once.</div>
            </div>
            <div class="btn-row">
                <button type="submit" class="btn">Sign in</button>
                <a class="btn btn-secondary" href="/login">Start again</a>
            </div>
        </form>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext? Http { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // only reachable straight after a correct password, for five minutes
        if (await TwoFactor.PendingUserAsync(Http?.Request.Cookies[TwoFactorEndpoints.PendingCookie], TwoFactorService.PurposeVerify) is null)
            Nav.NavigateTo("/login?error=expired");
    }
}
