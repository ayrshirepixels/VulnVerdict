# Copy to .env and edit. Nothing else is required for the first digest.
DB_PASSWORD=change-me-to-a-long-random-string
# Optional, recommended: a long random string (openssl rand -hex 32) that encrypts the console's encryption keys at
# rest, so a copy of the data volume or of a backup opens no saved credential on its own. Keep a copy somewhere else
# (a password manager): restoring a backup needs it, and without it the saved credentials are lost. See docs/security.md.
# VV_KEY_SECRET=
# Hostname the console answers on (certificate name). Use the DNS name your team will type.
VV_HOSTNAME=vulnverdict.internal
# Optional: only load CVEs from this year on for the first baseline (0 = every CVE since 1999, about 400k records)
CVE_MIN_YEAR=0
# The console image. The release bundle sets this to its release; update.sh changes it when you update.
# Comment it out to build from a checkout of this repository instead (docker compose up -d --build).
VV_IMAGE=ghcr.io/ayrshirepixels/vulnverdict:latest
# Optional: the database and TLS proxy images. The default is the latest release's (:db and :proxy);
# update.sh moves them to the images released with the console.
# VV_DB_IMAGE=ghcr.io/ayrshirepixels/vulnverdict:db
# VV_PROXY_IMAGE=ghcr.io/ayrshirepixels/vulnverdict:proxy
# Optional: where the nightly backups go. The default is a Docker volume on this machine; an absolute host path
# (a mounted share, another disk) keeps them off it. The folder must be writable by uid 10001. See docs/backup.md.
# VV_BACKUP_DIR=/mnt/backups/vulnverdict
