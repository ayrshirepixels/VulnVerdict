# Only 443 (and 80 for redirects) is exposed. Default is Caddy's internal CA, which suits an
# internal hostname; import its root certificate on the clients or point at your own CA.
# For a public hostname with a Let's Encrypt certificate, delete the "tls internal" line.
{
	# A browser opening the console by IP address sends no server name, and without a default
	# Caddy would refuse the handshake. Serve the hostname's certificate instead: the page loads
	# (with a name warning until the hostname is used or the root certificate is imported).
	default_sni {$VV_HOSTNAME}
}
# The hostname, plus a catch-all so a request by IP address (whose Host header is the address, not
# the name) reaches the console rather than an empty reply. The certificate is the hostname's.
{$VV_HOSTNAME}, https:// {
	tls internal
	encode gzip
	reverse_proxy web:8080
}
